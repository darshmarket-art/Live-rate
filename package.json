{
  "name": "antarixs-live-rate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Antarixs Live Rate: live gold and silver rates for every store from one licensed feed.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
